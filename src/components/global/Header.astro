---
/* Assets */
import { Image } from "astro:assets";
import photo from "../../assets/images/profile.jpeg";

/* Components */
import Text from "../elements/Text.astro";
import NavBar from "./NavBar.astro";
import SocialLinks from "../elements/SocialLinks.astro";

/* =========================================
   HEADER CONTENT
========================================= */
const {
    role = "Statistics Student | Cenderawasih University",
    name = "Prama Hardi Tonapa",
    status = "Available for work",
} = Astro.props;
---

<header
    class="
        relative
        z-50
        flex
        w-full
        min-w-0
        flex-col
        gap-8
        bg-base-950
        pt-8
        text-base-50
        md:gap-12
        md:pt-14
    "
>
    <!-- =====================================
         PROFILE SECTION
    ====================================== -->
    <div
        class="
            mx-auto
            flex
            w-full
            max-w-5xl
            min-w-0
            flex-col
            items-center
            gap-5
            px-4
            sm:px-6
            md:flex-row
            md:items-center
            md:gap-8
        "
    >
        <!-- PROFILE IMAGE -->
        <div class="flex shrink-0 items-center justify-center">
            <Image
                src={photo}
                alt="Foto profil Prama Hardi Tonapa"
                width={200}
                height={200}
                loading="eager"
                class="
                    aspect-square
                    h-28
                    w-28
                    shrink-0
                    rounded-full
                    object-cover
                    object-center
                    drop-shadow-md
                    ring-2
                    ring-base-800
                    md:h-32
                    md:w-32
                    lg:h-36
                    lg:w-36
                "
            />
        </div>

        <!-- PROFILE INFORMATION -->
        <div
            class="
                flex
                w-full
                min-w-0
                flex-col
                items-center
                gap-4
                md:flex-row
                md:items-center
                md:justify-between
            "
        >
            <!-- NAME, ROLE AND SOCIAL LINKS -->
            <div
                class="
                    flex
                    min-w-0
                    flex-col
                    items-center
                    text-center
                    md:items-start
                    md:text-left
                "
            >
                <Text variant="normal" class="text-base-700">
                    {role}
                </Text>

                <Text variant="xl" class="text-base-50">
                    {name}
                </Text>

                <div class="mt-3">
                    <SocialLinks />
                </div>
            </div>

            <!-- AVAILABILITY STATUS -->
            <div
                class="
                    availability-status
                    flex
                    shrink-0
                    items-center
                    justify-center
                    rounded-md
                    border
                    px-4
                    py-2
                    shadow-sm
                "
            >
                <Text variant="sm">
                    {status}
                </Text>
            </div>
        </div>
    </div>

    <!-- =====================================
         NAVIGATION BAR
    ====================================== -->
    <div class="w-full min-w-0">
        <NavBar />
    </div>
</header>
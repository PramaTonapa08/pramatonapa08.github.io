---
const pathname = Astro.url.pathname;

import Link from "../elements/Link.astro";

const nav = [
    { title: "HOME", href: "/" },
    { title: "PROJECTS", href: "/projects" },
    { title: "ABOUT", href: "/about" },
    { title: "BLOGS", href: "/blog" },
    { title: "CONTACT", href: "/contact" },
];
---

<nav
    class="flex w-full min-w-0 items-center justify-between gap-1 bg-base-900 px-2 py-1 sm:px-6 md:px-12 lg:px-32"
    aria-label="Main navigation"
>
    <div class="no-scrollbar flex min-w-0 items-center justify-start overflow-x-auto">
        {
            nav.map((navLink) => {
                const isActive =
                    navLink.href === "/"
                        ? pathname === "/"
                        : pathname === navLink.href ||
                          pathname.startsWith(`${navLink.href}/`);

                return (
                    <Link
                        variant="nav"
                        href={navLink.href}
                        text={navLink.title}
                        aria-current={isActive ? "page" : undefined}
                        class:list={[
                            isActive
                                ? "bg-base-950 border-t-2 border-base-500"
                                : "",
                        ]}
                    />
                );
            })
        }
    </div>

    <button
        id="theme-toggle"
        type="button"
        aria-label="Switch to light mode"
        title="Toggle theme"
        class="flex h-8 w-8 shrink-0 cursor-pointer items-center justify-center rounded-md text-xs transition-transform duration-200 hover:scale-105 sm:h-9 sm:w-9 sm:text-sm"
    >
        <span id="theme-icon" aria-hidden="true" class="inline-block transition-transform duration-300">☀️</span>
    </button>
</nav>

<script>
    function getSavedTheme(): string {
        return localStorage.getItem("theme") || "dark";
    }

    function applyTheme(theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);

        const icon = document.getElementById("theme-icon");
        const button = document.getElementById("theme-toggle");

        if (icon) {
            icon.textContent = theme === "dark" ? "☀️" : "🌙";
            icon.style.transform = theme === "dark" ? "rotate(0deg)" : "rotate(360deg)";
        }

        if (button) {
            button.setAttribute(
                "aria-label",
                theme === "dark"
                    ? "Switch to light mode"
                    : "Switch to dark mode"
            );
        }
    }

    applyTheme(getSavedTheme());

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const button = target.closest("#theme-toggle");
        if (!button) return;

        const currentTheme =
            document.documentElement.getAttribute("data-theme") || "dark";

        applyTheme(currentTheme === "dark" ? "light" : "dark");
    });

    document.addEventListener("astro:before-swap", (event) => {
        const theme = getSavedTheme();
        event.newDocument.documentElement.setAttribute("data-theme", theme);
    });

    document.addEventListener("astro:page-load", () => {
        applyTheme(getSavedTheme());
    });
</script>
---
/* Assets */
import { Image } from "astro:assets";
import photo from "../../assets/images/profile.jpeg";

/* Components */
import Text from "../elements/Text.astro";
import NavBar from "./NavBar.astro";
import SocialLinks from "../elements/SocialLinks.astro";

/* =========================================
   HEADER CONTENT
========================================= */
const {
    role = "Statistics Student | Cenderawasih University",
    name = "Prama Hardi Tonapa",
    status = "Available for work",
} = Astro.props;
---

<header
    class="
        relative
        z-50
        flex
        w-full
        min-w-0
        flex-col
        gap-5
        bg-base-950
        pt-6
        text-base-50
        sm:gap-6
        sm:pt-8
        md:gap-12
        md:pt-14
    "
>
    <!-- =====================================
         PROFILE SECTION
    ====================================== -->
    <div
        class="
            flex
            w-full
            min-w-0
            flex-col
            items-center
            gap-3.5
            px-4
            sm:gap-4
            sm:px-6
            md:flex-row
            md:items-center
            md:gap-8
            md:px-12
            lg:px-32
        "
    >
        <!-- PROFILE IMAGE -->
        <div
            class="
                flex
                h-24
                w-24
                shrink-0
                items-center
                justify-center
                overflow-hidden
                rounded-full
                drop-shadow-md
                ring-2
                ring-base-800
                sm:h-28
                sm:w-28
                lg:h-36
                lg:w-36
            "
        >
            <Image
                src={photo}
                alt="Foto profil Prama Hardi Tonapa"
                width={200}
                height={200}
                loading="eager"
                class="h-full w-full object-cover object-center"
            />
        </div>

        <!-- PROFILE INFORMATION -->
        <div
            class="
                flex
                w-full
                min-w-0
                flex-col
                items-center
                gap-3.5
                sm:gap-4
                md:flex-row
                md:items-center
                md:justify-between
                md:gap-6
            "
        >
            <!-- NAME, ROLE AND SOCIAL LINKS -->
            <div
                class="
                    flex
                    min-w-0
                    flex-col
                    items-center
                    justify-center
                    gap-3
                    sm:gap-4
                    md:items-start
                    md:gap-5
                "
            >
                <!-- ROLE AND NAME -->
                <div
                    class="
                        flex
                        min-w-0
                        flex-col
                        items-center
                        gap-1
                        text-center
                        sm:gap-1.5
                        md:items-start
                        md:text-left
                    "
                >
                    <Text variant="normal" class="text-base-400">
                        {role}
                    </Text>

                    <Text variant="xl" class="text-base-50">
                        {name}
                    </Text>
                </div>

                <!-- SOCIAL LINKS -->
                <div class="mt-0.5 sm:mt-1">
                    <SocialLinks />
                </div>
            </div>

            <!-- AVAILABILITY STATUS BADGE -->
            <div
                class="
                    availability-status
                    inline-flex
                    shrink-0
                    items-center
                    gap-2
                    rounded-full
                    border
                    border-base-700/80
                    bg-base-900/60
                    px-3.5
                    py-1.5
                    shadow-sm
                    sm:px-4
                    sm:py-2
                    md:self-center
                "
            >
                <span class="relative flex h-2.5 w-2.5 shrink-0">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
                </span>

                <Text variant="sm" class="leading-none tracking-wide">
                    {status}
                </Text>
            </div>
        </div>
    </div>

    <!-- =====================================
         NAVIGATION BAR
    ====================================== -->
    <div class="w-full min-w-0">
        <NavBar />
    </div>
</header>
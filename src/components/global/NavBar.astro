---
const pathname = Astro.url.pathname;

import Link from "../elements/Link.astro";

const nav = [
    { title: "HOME", href: "/" },
    { title: "PROJECTS", href: "/projects" },
    { title: "ABOUT", href: "/about" },
    { title: "BLOGS", href: "/blog" },
    { title: "CONTACT", href: "/contact" },
];
---

<nav
    class="sticky top-0 z-50 w-full bg-base-900 transition-none"
    aria-label="Main navigation"
>
    <div class="mx-auto flex w-full max-w-5xl min-w-0 items-center justify-between gap-1 px-2 py-2 sm:px-6">
        <!-- Navigation Links -->
        <div class="no-scrollbar flex min-w-0 flex-1 items-center justify-between overflow-x-auto sm:justify-start">
            {
                nav.map((navLink) => {
                    const isActive =
                        navLink.href === "/"
                            ? pathname === "/"
                            : pathname === navLink.href ||
                              pathname.startsWith(`${navLink.href}/`);

                    return (
                        <Link
                            variant="nav"
                            href={navLink.href}
                            text={navLink.title}
                            aria-current={isActive ? "page" : undefined}
                            class:list={[
                                "shrink-0 transition-none !px-2 !py-1.5 !text-xs sm:!px-4 sm:!py-2 sm:!text-base",
                                isActive
                                    ? "bg-base-950 border-t-2 border-base-900"
                                    : "hover:bg-base-800",
                            ]}
                        />
                    );
                })
            }
        </div>

        <!-- Theme Toggle -->
        <button
            id="theme-toggle"
            type="button"
            aria-label="Switch to light mode"
            title="Toggle theme"
            class="ml-1 flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-md text-base transition-transform duration-300 hover:scale-110 hover:opacity-80 focus-visible:outline focus-visible:outline-2 sm:h-10 sm:w-10 sm:text-lg"
        >
            <span id="theme-icon" aria-hidden="true" class="inline-block transition-transform duration-300">☀️</span>
        </button>
    </div>
</nav>

<script>
    function getSavedTheme(): string {
        return localStorage.getItem("theme") || "dark";
    }

    function applyTheme(theme: string) {
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("theme", theme);

        const icon = document.getElementById("theme-icon");
        const button = document.getElementById("theme-toggle");

        if (icon) {
            icon.textContent = theme === "dark" ? "☀️" : "🌙";
            icon.style.transform = theme === "dark" ? "rotate(0deg)" : "rotate(360deg)";
        }

        if (button) {
            button.setAttribute(
                "aria-label",
                theme === "dark"
                    ? "Switch to light mode"
                    : "Switch to dark mode"
            );
        }
    }

    applyTheme(getSavedTheme());

    document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const button = target.closest("#theme-toggle");
        if (!button) return;

        const currentTheme =
            document.documentElement.getAttribute("data-theme") || "dark";

        applyTheme(currentTheme === "dark" ? "light" : "dark");
    });

    document.addEventListener("astro:before-swap", (event) => {
        const theme = getSavedTheme();
        event.newDocument.documentElement.setAttribute("data-theme", theme);
    });

    document.addEventListener("astro:page-load", () => {
        applyTheme(getSavedTheme());
    });
</script>
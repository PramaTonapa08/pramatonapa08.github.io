---
// assets
import Calendar from "../../assets/icons/Calendar.astro";
import Github from "../../assets/icons/Github.astro";
import Website from "../../assets/icons/Website.astro";

// components
import Text from "../elements/Text.astro";
import Heading from "../elements/Heading.astro";
import Link from "../elements/Link.astro";
import Tag from "../elements/Tag.astro";

const { title, year, github, website, description, tools } = Astro.props;

// Detect Microsoft projects
const isExcelProject = tools?.includes("Microsoft Excel");
const isWordProject = tools?.includes("Microsoft Word");

// Project links
const links = [
    { icon: Github, text: "Source", url: github },
    { icon: Website, text: "Website", url: website },
];
---

<div class="border-2 border-base-900">
    <div class="bg-base-900 p-16 flex flex-col gap-16">
        <Heading tagName="h3" tagSize="h3">{title}</Heading>

        <div class="flex md:flex-row md:gap-32 flex-col gap-16">
            <div class="flex flex-row gap-8 text-base-100 items-center">
                <Calendar width={20} height={20} fill="currentColor" />
                <Text variant={'sm'} class="text-base-500">{year}</Text>
            </div>

            {
                links.map((link) => {
                    const Icon = link.icon;

                    return (
                        link.url && (
                            <div class="flex flex-row gap-8 text-base-100 items-center">

                                {
                                    link.text === "Website" && isExcelProject ? (
                                        // Microsoft Excel Logo (Black & White)
                                        <svg
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            xmlns="http://www.w3.org/2000/svg"
                                            aria-label="Microsoft Excel"
                                            role="img"
                                        >
                                            <path
                                                d="M13 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V9L13 2Z"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M13 2V9H20"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M3 10H13V19H3V10Z"
                                                fill="currentColor"
                                            />
                                            <path
                                                d="M5.5 12L10.5 17M10.5 12L5.5 17"
                                                stroke="#0B0D14"
                                                stroke-width="1.8"
                                                stroke-linecap="round"
                                            />
                                        </svg>
                                    ) : link.text === "Website" && isWordProject ? (
                                        // Microsoft Word Logo (Black & White)
                                        <svg
                                            width="20"
                                            height="20"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            xmlns="http://www.w3.org/2000/svg"
                                            aria-label="Microsoft Word"
                                            role="img"
                                        >
                                            <path
                                                d="M13 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V9L13 2Z"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M13 2V9H20"
                                                stroke="currentColor"
                                                stroke-width="1.5"
                                                stroke-linejoin="round"
                                            />
                                            <path
                                                d="M3 10H13V19H3V10Z"
                                                fill="currentColor"
                                            />
                                            <path
                                                d="M5.5 12L7.5 17L9 13.5L10.5 17L12 12"
                                                stroke="#0B0D14"
                                                stroke-width="1.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            />
                                        </svg>
                                    ) : (
                                        // Default GitHub / Website Icon
                                        <Icon
                                            width={20}
                                            height={20}
                                            fill="currentColor"
                                        />
                                    )
                                }

                                <Link
                                    variant={'inline'}
                                    href={link.url}
                                    text={link.text}
                                    newWindow
                                />
                            </div>
                        )
                    );
                })
            }
        </div>
    </div>

    <div class="p-16 flex flex-col gap-16">
        <Text variant={'normal'} class="text-base-400">
            {description}
        </Text>

        <div class="flex flex-row gap-16 flex-wrap">
            {
                tools.map((tool: string) => (
                    <Tag title={tool} />
                ))
            }
        </div>
    </div>
</div>

---
/* STYLES */
import "../styles/markdown.css";
import "../styles/global.css";

/* COMPONENTS */
import Wrapper from "../components/global/Wrapper.astro";
import BaseHead from "../components/global/BaseHead.astro";
import Header from "../components/global/Header.astro";
import Footer from "../components/global/Footer.astro";
import Heading from "../components/elements/Heading.astro";

const {
    title,
    description,
    titleTemplate,
    siteName,
    ogImage,
    twitterSite,
    themeColor,
    locale,
    ...seoProps
} = Astro.props;
---

<html lang="en">
    <BaseHead
        title={title}
        description={description}
        titleTemplate={titleTemplate}
        siteName={siteName}
        ogImage={ogImage}
        twitterSite={twitterSite}
        themeColor={themeColor}
        locale={locale}
        {...seoProps}
    />

    <body class="bg-base-950 text-base-300 font-retro-global">

        <Wrapper class="min-h-full w-full">

            <Header />

            <main
                class="
                    w-full
                    min-w-0
                    flex
                    flex-col
                    gap-24
                    px-16
                    md:gap-56
                    md:px-32
                "
            >
                <Heading tagName="h1" tagSize="h1">
                    {title}
                </Heading>

                <slot />
            </main>

            <Footer />

        </Wrapper>

    </body>
</html>

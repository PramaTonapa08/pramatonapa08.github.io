---
 // assets
import { Image } from "astro:assets";
import photo from "../../assets/images/profile.jpeg";

// components
import Text from "../elements/Text.astro";
import NavBar from "./NavBar.astro";
import SocialLinks from "../elements/SocialLinks.astro";

// Header content
const {
    role = "Statistics Student | Cenderawasih University",
    name = "Prama Hardi Tonapa",
    status = "Available for work"
} = Astro.props;

---
<header class="
    flex flex-col gap-24
    md:pt-56 pt-16
    bg-base-950
    text-base-50
    md:sticky md:top-0
    z-50
">

    <!-- Profile Section -->
    <div class="
        md:px-32 px-16
        flex md:flex-row flex-col
        gap-16
        items-center
    ">

        <!-- Profile Image -->
        <Image
            src={photo}
            alt="Prama Hardi Tonapa"
            width={200}
            height={200}
            densities={[1, 1.5, 2]}
            loading="lazy"
            class="
                object-cover object-center
                w-25 h-25
                rounded-full
                drop-shadow-md
            "
        />

        <!-- Profile Information -->
        <div class="
            flex md:flex-row flex-col
            gap-24
            justify-between
            items-center
            w-full
        ">

            <!-- Name and Social Links -->
            <div class="
                flex flex-col gap-24
                md:items-start
                justify-center items-center
            ">

                <div class="
                    flex flex-col
                    md:text-left text-center
                ">

                    <!-- Role -->
                    <Text
                        variant="normal"
                        class="text-base-700"
                    >
                        {role}
                    </Text>

                    <!-- Name -->
                    <Text
                        variant="xl"
                        class="text-base-50"
                    >
                        {name}
                    </Text>

                </div>

                <!-- Social Links -->
                <SocialLinks />

            </div>

            <!-- Availability Status -->
            <div class="
                availability-status
                px-16 py-8
                rounded-md
                border
                shadow-sm
            ">
                <Text variant="sm">
                    {status}
                </Text>
            </div>
        </div>
    </div>

    <!-- Navigation Bar -->
    <NavBar />
</header>

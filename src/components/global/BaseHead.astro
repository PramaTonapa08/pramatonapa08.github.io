---
// assets
import { Font } from "astro:assets";

// router
import { ClientRouter } from "astro:transitions";

// components
import Seo, { type Props as SEOProps } from "../../components/global/Seo.astro";

// Site-wide defaults
const SITE_NAME = "Prama Hardi";
const TITLE_TMPL = "%s | Prama Hardi";
const DEFAULT_OG = "/images/Black and White Monochrome Tech Logo.jpg";
const TWITTER_SITE = "@handle";
const THEME_COLOR = "oklch(0.216 0.070 132.8)";
const LOCALE = "en_US";

// Layout accepts all SEO props + standard layout props
export interface Props extends SEOProps {
    /** Extra <head> content injected after SEO tags (optional). */
    headSlot?: boolean;
}

const {
    title,
    description,
    titleTemplate = TITLE_TMPL,
    siteName = SITE_NAME,
    ogImage = DEFAULT_OG,
    twitterSite = TWITTER_SITE,
    themeColor = THEME_COLOR,
    locale = LOCALE,
    ...seoProps
} = Astro.props;
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- =====================================
         EARLY THEME INITIALIZATION
         Prevent theme flash before rendering
    ====================================== -->

    <script is:inline>
        (() => {
            const savedTheme = localStorage.getItem("theme") || "dark";

            document.documentElement.setAttribute(
                "data-theme",
                savedTheme
            );
        })();
    </script>

    <!-- Astro Client Router -->
    <ClientRouter />

    <!-- Favicon -->
    <link
        rel="icon"
        type="image/jpg"
        href="/Black and White Monochrome Tech Logo.jpg"
    />

    <link
        rel="icon"
        href="/Black and White Monochrome Tech Logo.jpg"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts -->
    <Font cssVariable="--font-pixels" />
    <Font cssVariable="--font-mono" />

    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <Seo
        title={title}
        description={description}
        titleTemplate={titleTemplate}
        siteName={siteName}
        ogImage={ogImage}
        twitterSite={twitterSite}
        themeColor={themeColor}
        locale={locale}
        {...seoProps}
    />
</head>